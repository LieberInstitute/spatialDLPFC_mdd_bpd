Bootstrap: docker
From: debian:bookworm-slim

%labels
    org.opencontainers.image.title MBv Python environment
    org.opencontainers.image.version 0.1-test
    org.opencontainers.image.description Portable pySCENIC Conda environment for MBv pipeline validation

%files
    reproducibility_inputs/conda-linux-64.lock /opt/mbv/reproducibility_inputs/conda-linux-64.lock
    reproducibility_inputs/requirements-pip.lock /opt/mbv/reproducibility_inputs/requirements-pip.lock
    reproducibility_inputs/wheels /opt/mbv/reproducibility_inputs/wheels
    container/scripts/build_apptainer_env.sh /opt/mbv/scripts/build_apptainer_env.sh
    container/scripts/build_portable_env.sh /opt/mbv/scripts/build_portable_env.sh
    container/scripts/verify_python_env.py /opt/mbv/scripts/verify_python_env.py

%post
    set -eu
    bash /opt/mbv/scripts/build_apptainer_env.sh python portable

%environment
    export PATH=/opt/conda/envs/pyscenic/bin:/opt/conda/bin:$PATH

%test
    set -eu
    python /opt/mbv/scripts/verify_python_env.py
    python -m pip check

%runscript
    exec "$@"
