params.n_samples = 119
params.container_runtime = ''

outputDir = "${launchDir}"
report.overwrite = true

workflow {
    failOnIgnore = true
    output.mode = 'copy'
}

profiles {
    docker {
        params.container_runtime = 'docker'
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
        process.executor = 'local'
        process {
            withName: NNSVG_PER_SAMPLE {
                cpus = 1
                maxForks = 1
            }
        }
    }
    apptainer {
        params.container_runtime = 'apptainer'
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.executor = 'slurm'
        process.memory = 6.GB
        process.beforeScript = 'module load apptainer/1.5.3' // this is needed for the slurm executor to load the apptainer module before running the process
        // Slurm/HPC-specific config the manage job/process-specific memory requirements
        includeConfig 'workflows/modules/Stage01_create-spe/HPC_resources.config'
    }
    test {
        params.n_samples = 7
        params.spe_dir = 'test/processed-data/Stage01_create-spe'
        outputDir = 'test'
    }
}
// Resolve stage 2 resources after all profiles have supplied their sample count (allows for array job to pull from input param)
includeConfig (params.container_runtime == 'apptainer'
    ? 'workflows/modules/Stage02_QC-annotation/HPC_resources.config'
    : '/dev/null')

// Unique trace for each invocation, including failed and cached sample tasks.
params.task_trace_file = "${launchDir}/.nextflow/logs/tasks-${System.currentTimeMillis()}.tsv"
trace {
    enabled = true
    file = params.task_trace_file
    fields = 'process,tag,status,exit,native_id,workdir'
}
