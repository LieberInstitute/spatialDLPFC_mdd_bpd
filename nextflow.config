docker.enabled = true
docker.runOptions = '--platform linux/amd64'

report.overwrite = true

process {
    executor = 'local'
}

outputDir = "nextflow_outputs"
workflow {
    output.mode = 'copy'
}

profiles {
    test {
        params.n_samples = 3
    }
    full {
        params.n_samples = 119
    }
}